set -e

. common.sh

debug set -x

# If the target device is not a real block device we'll first losetup it.
# This is needed for file disks.
if [ ! -b $blockdev ]; then
    ORIGINAL_BLOCKDEV=$blockdev
    blockdev=$($LOSETUP -sf $blockdev)
    CLEANUP+=("$LOSETUP -d $blockdev")
fi

if [ ! "${NOMOUNT}" = "yes" ] ; then
    filesystem_dev=$(map_disk0 $blockdev)
    CLEANUP+=("unmap_disk0 $blockdev")
    root_dev=$(map_partition $filesystem_dev root)
    boot_dev=$(map_partition $filesystem_dev boot)
fi

TARGET=`mktemp -d --tmpdir=${EXPORT_DIR}` || exit 1
CLEANUP+=("rmdir $TARGET")

if [ "${NOMOUNT}" = "yes" ] ; then
    # convert block device to qcow2 image to support OS's like Windows. Use
    # qcow2 to conserve on space.
    $QEMU_IMG convert $blockdev -O qcow2 ${TARGET}/disk.img
    CLEANUP+=("rm ${TARGET}/disk.img")
else
    # Create tarball export
    TARGET=`mktemp -d` || exit 1
    CLEANUP+=("rmdir $TARGET")

    # Mount the filesystems for tarball creation
    mount_disk0 $TARGET

    OLDPWD=$PWD
    cd $TARGET

    # Create compressed tarball
    if [ -x /usr/bin/pigz ] ; then
        tar -I /usr/bin/pigz --numeric-owner -cpf - .
    else
        tar --numeric-owner -zcpf - .
    fi

    cd $OLDPWD
fi

( cd $TARGET ; tar -cf - . )

# execute cleanups
cleanup
trap - EXIT

exit 0
